# ==============================================================================
# EarlyAI ATS — Environment Variables Example
# Duplicate this file as .env in respective workspace or root.
# NEVER commit real credentials, passwords, or secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (apps/api)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/earlyai_ats?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_secure_random_32_byte_secret_key
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Frontend Configuration (apps/web)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api/v1

# ------------------------------------------------------------------------------
# AI Provider Configuration
# ------------------------------------------------------------------------------
# Default provider for local development is ollama (no external API keys required).
# Options: ollama | gemini | groq | mock
AI_PROVIDER=ollama
AI_FALLBACK_PROVIDER=none
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_MS=120000

# Optional cloud providers (only required if AI_PROVIDER is set to gemini or groq)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# Resume Storage Configuration
# ------------------------------------------------------------------------------
# Driver options: local | r2
# Default for development and automated tests is local filesystem storage.
# Production deployments should configure r2 for durable object storage.
RESUME_STORAGE_DRIVER=local
RESUME_STORAGE_DIR=uploads/resumes

# Cloudflare R2 Object Storage (only required when RESUME_STORAGE_DRIVER=r2)
# Create a private bucket in Cloudflare R2 dashboard (e.g. earlyhire-ats-resumes-prod)
# Generate R2 API tokens with Object Read & Write permissions scoped to the bucket.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ENDPOINT=https://<your_cloudflare_account_id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=earlyhire-ats-resumes-prod
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# ------------------------------------------------------------------------------
# Google Calendar & Meet Integration (Optional)
# ------------------------------------------------------------------------------
# Enable automatic Google Meet generation with conferenceDataVersion=1.
# 1. Create a Google Cloud Project at https://console.cloud.google.com/
# 2. Enable the Google Calendar API: APIs & Services > Enable APIs and Services > Google Calendar API
# 3. Configure OAuth Consent Screen: User Type: External or Internal; Add scope: https://www.googleapis.com/auth/calendar.events
# 4. Create OAuth 2.0 Client ID (Web Application):
#    - Authorized JavaScript origins: http://localhost:5173 (Web App)
#    - Authorized redirect URIs: http://localhost:5000/api/v1/auth/google/callback
# 5. Populate GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# 32-byte secret / passphrase used to encrypt recruiter OAuth refresh tokens in MongoDB using AES-256-GCM.
# If omitted in development, a deterministic key derived from JWT_SECRET is used safely as fallback.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Optional system-wide fallback refresh token (if individual recruiter OAuth is not used)
GOOGLE_CALENDAR_REFRESH_TOKEN=

# ------------------------------------------------------------------------------
# Email Notification Configuration (Optional)
# ------------------------------------------------------------------------------
# When enabled and configured, transactional emails are dispatched for
# application submission, stage changes, interview scheduling, and offers.
# If omitted or disabled, in-app notifications continue to function seamlessly.
EMAIL_ENABLED=false
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EarlyAI ATS <no-reply@earlyhire.ai>"

