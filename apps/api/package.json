{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --fileParallelism=false",
    "test:r2-smoke": "tsx src/scripts/liveR2SmokeTest.ts",
    "bootstrap:platform-manager": "tsx src/scripts/bootstrapPlatformManager.ts",
    "seed:demo": "tsx src/scripts/seedDemoData.ts",
    "migrate:roles": "tsx src/scripts/migrateRoles.ts",
    "test:screening-e2e": "tsx src/scripts/verifyScreeningE2E.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.4",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^9.20.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
